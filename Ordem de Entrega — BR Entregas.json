    {
      "parameters": {
        "jsCode": "async function cepParaLatLong(cep) {\n  // 1. Busca endereço no ViaCEP\n  cep = cep.replace(\"-\", \"\");\n  const dados = await this.helpers.httpRequest({\n    method: \"GET\",\n    url: `https://viacep.com.br/ws/${cep}/json/`,\n    json: true,\n  });\n\n  if (dados.erro) {\n    throw new Error(`CEP ${cep} não encontrado`);\n  }\n\n  const endereco = `${dados.logradouro}, ${dados.localidade}, ${dados.uf}, Brasil`;\n\n  // 2. Geocodifica no Nominatim\n  const resultados = await this.helpers.httpRequest({\n    method: \"GET\",\n    url: \"https://nominatim.openstreetmap.org/search\",\n    qs: {\n      q: endereco,\n      format: \"json\",\n      limit: \"1\",\n    },\n    headers: { \"User-Agent\": \"meu-projeto-faculdade/1.0\" }, // obrigatório!\n    json: true,\n  });\n\n  console.log(\"Calculando distância.....\");\n  await new Promise((resolve) => setTimeout(resolve, 1000)); // respeitar rate limit do Nominatim (1 req/s)\n\n  if (!resultados.length) {\n    throw new Error(`Endereço não geocodificado: ${endereco}`);\n  }\n\n  const lat = parseFloat(resultados[0].lat);\n  const lon = parseFloat(resultados[0].lon);\n  return { lat, lon };\n}\n\nasync function calcularRota(cepOrigem, cepDestino) {\n  const { lat: lat1, lon: lon1 } = await cepParaLatLong.call(this, cepOrigem);\n  const { lat: lat2, lon: lon2 } = await cepParaLatLong.call(this, cepDestino);\n\n  // OSRM espera lon,lat (invertido!)\n  console.log(\"Calculando distância.....\");\n  const url =\n    `https://router.project-osrm.org/route/v1/driving/` +\n    `${lon1},${lat1};${lon2},${lat2}` +\n    `?overview=full&geometries=geojson`;\n\n  const dados = await this.helpers.httpRequest({\n    method: \"GET\",\n    url,\n    qs: { overview: \"full\", geometries: \"geojson\" },\n    json: true,\n  });\n\n  if (dados.code !== \"Ok\") {\n    throw new Error(`Erro ao calcular rota: ${dados.message || dados.code}`);\n  }\n\n  const rota = dados.routes[0];\n\n  return {\n    distancia_km: rota.distance / 1000,\n    duracao_min: rota.duration / 60,\n    geometria: rota.geometry, // GeoJSON LineString da rota\n    origem: { lat: lat1, lon: lon1 },\n    destino: { lat: lat2, lon: lon2 },\n  };\n}\n\n// Uso\nconst cep1 = $input.first().json.cep_ori;\nconst cep2 = $input.first().json.cep_dst;\nconst resultado = await calcularRota.call(this, cep1, cep2);\n\nconsole.log(`Distância: ${resultado.distancia_km.toFixed(1)} km`);\nconsole.log(`Duração: ${resultado.duracao_min.toFixed(0)} min`);\n\nreturn [{ json: resultado }];"
      },
