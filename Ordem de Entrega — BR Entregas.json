    {
      "parameters": {
        "content": "Criat tabela com estes parametros:\n\nCREATE TABLE ordens_entrega (\n    id          SERIAL          PRIMARY KEY,\n\n    veiculo     VARCHAR(50)     NOT NULL,\n    carga       VARCHAR(100)    NOT NULL,\n\n    nome_origem       VARCHAR(150)  NOT NULL,\n    cep_origem        CHAR(8)       NOT NULL,\n    endereco_origem   VARCHAR(255)  NOT NULL,\n\n    nome_destino      VARCHAR(150)  NOT NULL,\n    cep_destino       CHAR(8)       NOT NULL,\n    endereco_destino  VARCHAR(255)  NOT NULL,\n    referencia  VARCHAR(100)  NULL,\n\n    status      VARCHAR(30)     NOT NULL  DEFAULT 'pendente',\n    criado_em   TIMESTAMP       NOT NULL  DEFAULT CURRENT_TIMESTAMP\n);",
        "height": 416,
        "width": 928
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        192,
        -496
      ],
      "id": "8969438b-2825-4bf9-ba32-823d8e66adea",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json;\n\nconst veiculo = data['Tipo de veículo:'] ?? '';\nconst carga   = data['Tipo de carga']   ?? '';\nconst nome_ori = (data['Nome do solicitante'] ?? '').trim();\nconst cep_ori = (data['CEP de Origem']  ?? '').replace('-', '').trim();\nconst end_ori = (data['Endereço completo de Origem '] ?? '').trim();\nconst nome_dst = (data['Nome do destinatario:'] ?? '').trim();\nconst cep_dst = (data['CEP de Destino'] ?? '').replace('-', '').trim();\nconst end_dst = (data['Endereço completo de Destino'] ?? '').trim();\nconst referencia = (data['Referencia'] ?? '').trim();\n\nconst mensagem =\n  `🚚 *NOVA ORDEM DE ENTREGA*\\n` +\n  `━━━━━━━━━━━━━━━━━━━━━━━\\n` +\n  `🫡 *Solicitante*: ${nome_ori}\\n` +\n  `🚗 *Veículo:* ${veiculo}\\n` +\n  `📦 *Carga:* ${carga}\\n` +\n  `\\n` +\n  `📍 *ORIGEM*\\n` +\n  `CEP: ${cep_ori}\\n` +\n  `Endereço: ${end_ori}\\n` +\n  `\\n` +\n  `🏁 *DESTINO*\\n` +\n  `Nome destinatário: ${nome_dst}\\n` +\n  `CEP: ${cep_dst}\\n` +\n  `Endereço: ${end_dst}\\n` +\n  `Referencia: ${referencia}\\n` +\n  `━━━━━━━━━━━━━━━━━━━━━━━\\n`;\n\nreturn {\n  veiculo,\n  carga,\n  nome_ori,\n  cep_ori,\n  end_ori,\n  nome_dst,\n  cep_dst,\n  end_dst,\n  referencia,\n  mensagem,\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
