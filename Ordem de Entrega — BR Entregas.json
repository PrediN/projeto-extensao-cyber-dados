    {
      "parameters": {
        "fromEmail": "testepedropython@gmail.com",
        "toEmail": "testepedropython@gmail.com",
        "subject": "Projeto 4SM",
        "html": "=🚚 <b>NOVA ORDEM DE ENTREGA</b><br>\n━━━━━━━━━━━━━━━━━━━━━━━<br>\n🫡 <b>Solicitante</b>: {{ $('Parser de Form -> Query SQL').item.json.nome_ori }}<br>\n🚗 <b>Veículo</b>: {{ $('Parser de Form -> Query SQL').item.json.veiculo }}<br>\n📦 <b>Carga</b>: {{ $('Parser de Form -> Query SQL').item.json.carga }}<br>\n<br>\n📍 <b>ORIGEM</b><br>\n<b>CEP</b>: {{ $('Parser de Form -> Query SQL').item.json.cep_ori }}<br>\n<b>Endereço</b>: {{ $('Parser de Form -> Query SQL').item.json.end_ori }}<br>\n\n🏁 <b>DESTINO</b><br>\n<b>Nome destinatário</b>: {{ $('Parser de Form -> Query SQL').item.json.nome_dst }}<br>\n<b>CEP</b>: {{ $('Parser de Form -> Query SQL').item.json.cep_dst }}<br>\n<b>Endereço</b>: {{ $('Parser de Form -> Query SQL').item.json.end_dst }}<br>\n<b>Referencia</b>: {{ $('Parser de Form -> Query SQL').item.json.referencia }}<br>\n\n🗺️ <b>ROTA CALCULADA</b><br>\n<b>TEMPO ESTIMADO</b>: {{ $json.duracao_min }}<br>\n<b>DISTANCIA ESTIMADA</b>: {{ $json.distancia_km }}<br>\n━━━━━━━━━━━━━━━━━━━━━━━",
